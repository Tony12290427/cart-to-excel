# The management platform has its own login client. Keep local test origins
# separate from the existing production uploader client.
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://127.0.0.1:8787
DB_PATH=./data/orders.sqlite
GOOGLE_CLIENT_ID=
# Sign in once, copy the Google account ID shown on the pending-membership page,
# set it here and restart. No email allowlist is required for team enrollment.
BOOTSTRAP_ADMIN_SUB=
DRIVE_FOLDER_ID=1EC0L0S0kHn8UAIEY-nukXsTujPfX2ImG
SYNC_INTERVAL_SECONDS=300
# Prefer ADC / workload identity. If a service-account JSON is necessary, store
# it OUTSIDE this repository and put only its absolute path here.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/drive-reader.json
# Optional keyless impersonation (caller needs Token Creator on this account):
# DRIVE_SERVICE_ACCOUNT=order-reader@your-project.iam.gserviceaccount.com
# Deployment requires HTTPS, persistent storage, backups and NODE_ENV=production.
